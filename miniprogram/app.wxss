/* ========= 可樂 · 全局设计系统 ========= */
page {
  /* 色彩 */
  --brand: #171717;
  --brand-deep: #262626;
  --brand-soft: #F4F4F4;
  --brand-line: #DEDEDE;
  --gold: #525252;
  --gold-soft: #F5F5F5;
  --bg: #FFFFFF;
  --card: #FFFFFF;
  --ink: #171717;
  --ink-2: #737373;
  --ink-3: #8A8A8A;
  --line: #EAEAEA;
  --ok: #4CAF7D;
  --ok-soft: #E9F5EF;
  --warn: #E8834A;
  --warn-soft: #FDF0E6;
  --bad: #E05A5A;
  --bad-soft: #FBEAEA;

  background: #FFFFFF;
  color: #171717;
  font-size: 28rpx;
  line-height: 1.55;
  font-family: -apple-system, BlinkMacSystemFont, 'PingFang SC', 'Helvetica Neue', sans-serif;
}

/* —— 通用布局 —— */
.page { padding: 24rpx 32rpx 48rpx; box-sizing: border-box; }
.page-flush { padding: 0 0 48rpx; box-sizing: border-box; }
.row { display: flex; align-items: center; }
.row-between { display: flex; align-items: center; justify-content: space-between; }
.row-wrap { display: flex; flex-wrap: wrap; }
.col { display: flex; flex-direction: column; }
.flex-1 { flex: 1; min-width: 0; }
.ellipsis { overflow: hidden; white-space: nowrap; text-overflow: ellipsis; }
.ellipsis-2 { display: -webkit-box; -webkit-box-orient: vertical; -webkit-line-clamp: 2; overflow: hidden; }

/* —— 卡片 —— */
.card {
  background: #FFFFFF;
  border-radius: 24rpx;
  padding: 28rpx;
  box-sizing: border-box;
  box-shadow: 0 6rpx 24rpx rgba(122, 80, 80, 0.05);
}
.card + .card { margin-top: 24rpx; }
.section { margin-top: 32rpx; }
.section-title {
  display: flex; align-items: center; justify-content: space-between;
  margin: 0 4rpx 20rpx;
  font-size: 32rpx; font-weight: 600; color: #171717;
}
.section-title .more { font-size: 24rpx; font-weight: 400; color: #8A8A8A; }

/* —— 文字 —— */
.t-title { font-size: 32rpx; font-weight: 600; color: #171717; }
.t-sub { font-size: 24rpx; color: #737373; }
.t-tip { font-size: 22rpx; color: #8A8A8A; }
.t-brand { color: #171717; }
.t-gold { color: #525252; }
.t-ok { color: #4CAF7D; }
.t-bad { color: #E05A5A; }
.t-bold { font-weight: 600; }
.t-num { font-family: 'DIN Alternate', -apple-system, sans-serif; font-weight: 600; }
.price { color: #171717; font-weight: 600; }
.price .unit { font-size: 22rpx; font-weight: 400; }

/* —— 图标 —— */
.ic { width: 40rpx; height: 40rpx; flex-shrink: 0; }
.ic-sm { width: 32rpx; height: 32rpx; flex-shrink: 0; }
.ic-lg { width: 56rpx; height: 56rpx; flex-shrink: 0; }
.ic-badge {
  width: 72rpx; height: 72rpx; border-radius: 22rpx;
  background: #F4F4F4;
  display: flex; align-items: center; justify-content: center;
}

/* —— 按钮 —— */
.btn {
  display: flex; align-items: center; justify-content: center;
  height: 88rpx; border-radius: 44rpx;
  font-size: 30rpx; font-weight: 600;
  transition: opacity .15s ease;
}
.btn::after { border: none; }
.btn-primary { background: #171717; color: #fff; box-shadow: 0 10rpx 24rpx rgba(0, 0, 0, 0.32); }
.btn-ghost { background: #fff; color: #171717; border: 2rpx solid #DEDEDE; }
.btn-soft { background: #F4F4F4; color: #262626; }
.btn-mini {
  display: inline-flex; align-items: center; justify-content: center;
  height: 56rpx; padding: 0 26rpx; border-radius: 30rpx;
  font-size: 24rpx; font-weight: 500;
  background: #F4F4F4; color: #262626;
}
.btn-mini.line { background: #fff; border: 2rpx solid #EAEAEA; color: #737373; }
.btn-mini.primary { background: #171717; color: #fff; }
.btn-disabled { opacity: .45; pointer-events: none; }
.btn-block { width: 100%; }

/* —— 列表单元 —— */
.cell {
  display: flex; align-items: center;
  padding: 28rpx 4rpx;
  border-bottom: 2rpx solid #EAEAEA;
}
.cell:last-child { border-bottom: none; }
.cell-title { flex: 1; min-width: 0; font-size: 30rpx; color: #171717; }
.cell-desc { font-size: 24rpx; color: #8A8A8A; margin-top: 4rpx; }
.cell-arrow { width: 32rpx; height: 32rpx; opacity: .5; }

/* —— 标签 —— */
.tag {
  display: inline-flex; align-items: center;
  height: 40rpx; padding: 0 16rpx; border-radius: 10rpx;
  font-size: 20rpx; font-weight: 500;
  white-space: nowrap; flex-shrink: 0;
  background: #F4F4F4; color: #262626;
}
.tag.gold { background: #F5F5F5; color: #525252; }
.tag.ok { background: #E9F5EF; color: #34885D; }
.tag.warn { background: #FDF0E6; color: #C06428; }
.tag.bad { background: #FBEAEA; color: #C24B4B; }
.tag.gray { background: #F3F3F3; color: #737373; }

/* —— 表单 —— */
.form-item { display: flex; align-items: center; min-height: 100rpx; border-bottom: 2rpx solid #EAEAEA; }
.form-item:last-child { border-bottom: none; }
.form-label { width: 180rpx; font-size: 28rpx; color: #737373; flex-shrink: 0; }
.form-input { flex: 1; font-size: 30rpx; color: #171717; }
.form-value { flex: 1; font-size: 30rpx; color: #171717; }
.form-placeholder { color: #8A8A8A; }
.form-textarea { flex: 1; font-size: 28rpx; color: #171717; min-height: 120rpx; padding-top: 24rpx; box-sizing: border-box; }

/* —— 空状态 —— */
.empty { padding: 100rpx 0; display: flex; flex-direction: column; align-items: center; }
.empty .ic { width: 88rpx; height: 88rpx; opacity: .35; margin-bottom: 24rpx; }
.empty-text { font-size: 26rpx; color: #8A8A8A; }

/* —— 徽标 —— */
.badge {
  min-width: 32rpx; height: 32rpx; padding: 0 8rpx; border-radius: 16rpx;
  background: #E05A5A; color: #fff; font-size: 20rpx;
  display: flex; align-items: center; justify-content: center;
}

/* —— 分页标签 —— */
.tabs { display: flex; gap: 16rpx; }
.tab {
  height: 64rpx; padding: 0 28rpx; border-radius: 32rpx;
  display: flex; align-items: center; font-size: 26rpx;
  background: #fff; color: #737373; border: 2rpx solid #EAEAEA;
}
.tab.active { background: #171717; border-color: #171717; color: #fff; font-weight: 600; }

/* —— 加载 —— */
.loading-tip { text-align: center; padding: 24rpx 0; font-size: 24rpx; color: #8A8A8A; }
.divider { height: 2rpx; background: #EAEAEA; margin: 24rpx 0; }

/* —— 底部 Dock 栏占位（自定义 tabBar 不会自动撑开页面，需手动留白）—— */
.tabbar-space { height: calc(150rpx + env(safe-area-inset-bottom)); }

/* 设置页：身份预览标签 */
.tag.preview { background: rgba(0, 0, 0, .12); color: #262626; white-space: nowrap; }

/* Monochrome editorial design */
.card { border: 2rpx solid #eaeaea; border-radius: 28rpx; box-shadow: none; }
.section { margin-top: 44rpx; }
.section-title { font-size: 34rpx; letter-spacing: 2rpx; }
.ic-badge { border-radius: 50%; background: #fff; border: 2rpx solid #dedede; }
.ic, .ic-sm, .ic-lg { filter: grayscale(1); }
.btn-primary { box-shadow: none; }
